{
  "name": "rwns",
  "version": "2.0.0",
  "description": "A Robot Walkin'n'Shootin game",
  "license": "AGPL-3.0-or-later",
  "author": "Jacek Kopecky <jacek@jacek.cz>",
  "type": "module",
  "main": "index.html",
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "build": "VITE_BUILD_VERSION=`/bin/echo -n $(date '+%Y-%m-%d %H:%M') \"($(git rev-parse --short HEAD))\"` vite build",
    "build-and-commit": "echo 'checking working tree is clean' && git status --porcelain --untracked-files=no && test -z \"`git status --porcelain --untracked-files=no`\" && npm run test-all && npm run build && sh deploy.sh || echo 'FAILED: something not right'",
    "test-all": "npm run test && npm run test:e2e",
    "test": "npm run lint && npm run type-check && vitest run src/",
    "test-watch": "vitest src/",
    "test:e2e": "playwright test",
    "test:e2e-watch": "node --watch --watch-path=index.html --watch-path=assets --watch-path=src --watch-path=tests ./node_modules/.bin/playwright test",
    "test:e2e-update-snapshots": "playwright test --update-snapshots",
    "type-check": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.tests.json",
    "compile": "npm run type-check",
    "lint": "prettier -c . && eslint --ext .ts,.tsx src",
    "lint-fix": "eslint --ext .ts,.tsx src --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/seedrandom": "^3.0.8",
    "@types/three": "^0.183.1",
    "eslint": "^10.4.0",
    "prettier": "^3.9.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@tweenjs/tween.js": "^25.0.0",
    "seedrandom": "^3.0.5",
    "three": "^0.183.2",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
